<Project>
  <!-- Shared settings for the decompiled APZON IRS projects (build 2026-07-13). -->
  <PropertyGroup>
    <LibDir>$(MSBuildThisFileDirectory)lib\</LibDir>
    <!-- WinForms .resx files hold images/icons; SDK builds for .NET Framework need preserialized resources. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;MSB3277;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
</Project>
