<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Apzon.HDBConnection</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net462</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup />
  <ItemGroup>
    <Reference Include="Sap.Data.Hana.v4.5">
      <HintPath>$(LibDir)Sap.Data.Hana.v4.5.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Data">
      <HintPath>$(LibDir)System.Data.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Npgsql">
      <HintPath>$(LibDir)Npgsql.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Z.BulkOperations">
      <HintPath>$(LibDir)Z.BulkOperations.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Transactions">
      <HintPath>$(LibDir)System.Transactions.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Core" />
  </ItemGroup>
</Project>